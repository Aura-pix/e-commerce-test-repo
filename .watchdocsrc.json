{
  "version": 1,
  "watch": {
    "routes": [
      "src/routes/**/*.{ts,js}",
      "routes/**/*.{ts,js}",
      "src/controllers/**/*.{ts,js}",
      "controllers/**/*.{ts,js}",
      "src/app.{ts,js}",
      "app.{ts,js}",
      "src/index.{ts,js}",
      "src**/*.{ts,js}"
    ]
  },
  "docs": {
